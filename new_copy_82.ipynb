   "source": [
    "# ===== QM9 paired condition -> decoded molecule plot =====\n",
    "# This decodes from the actual graph-level condition vectors of real test molecules,\n",
    "# then plots each conditioning molecule next to the molecule decoded from its condition.\n",
    "if globals().get(\"DATASET_MODE\") == \"qm9\":\n",
    "    import random\n",
    "    from collections import Counter\n",
    "\n",
    "    import networkx as nx\n",
    "    import numpy as np\n",
    "    import pandas as pd\n",
    "    from IPython.display import display\n",
    "    from rdkit import Chem\n",
    "    from rdkit.Chem import AllChem, Draw\n",
    "\n",
    "    QM9_CONDITION_DECODE_N = 100\n",
    "    QM9_CONDITION_DISPLAY_N = 12\n",
    "    QM9_CONDITION_PLOT_SEED = 123\n",
    "    QM9_CONDITION_DECODE_STEPS = 100\n",
    "\n",
    "    def _nx_molecule_to_rdkit_safe_local(G):\n",
    "        mol = Chem.RWMol()\n",
    "        node_to_atom = {}\n",
    "        for node, data in G.nodes(data=True):\n",
    "            symbol = str(data.get(\"label\", \"C\"))\n",
    "            try:\n",
    "                node_to_atom[node] = mol.AddAtom(Chem.Atom(symbol))\n",
    "            except Exception:\n",
    "                return None, f\"bad atom label {symbol!r}\"\n",
    "\n",
    "        for u, v, data in G.edges(data=True):\n",
    "            raw = str(data.get(\"label\", \"1\"))\n",
    "            if raw in {\"1\", \"1.0\", \"SINGLE\"}:\n",
    "                bond_type = Chem.BondType.SINGLE\n",
    "            elif raw in {\"2\", \"2.0\", \"DOUBLE\"}:\n",
    "                bond_type = Chem.BondType.DOUBLE\n",
    "            elif raw in {\"3\", \"3.0\", \"TRIPLE\"}:\n",
    "                bond_type = Chem.BondType.TRIPLE\n",
    "            elif raw in {\"1.5\", \"AROMATIC\"}:\n",
    "                bond_type = Chem.BondType.AROMATIC\n",
    "            else:\n",
    "                return None, f\"bad bond label {raw!r}\"\n",
    "            try:\n",
    "                mol.AddBond(node_to_atom[u], node_to_atom[v], bond_type)\n",
    "            except Exception as exc:\n",
    "                return None, str(exc)\n",
    "\n",
    "        out = mol.GetMol()\n",
    "        try:\n",
    "            Chem.SanitizeMol(out)\n",
    "        except Exception as exc:\n",
    "            return out, str(exc)\n",
    "        return out, None\n",
    "\n",
    "    def _graph_atom_hist(G):\n",
    "        return Counter(str(data.get(\"label\")) for _, data in G.nodes(data=True))\n",
    "\n",
    "    def _graph_bond_hist(G):\n",
    "        return Counter(str(data.get(\"label\", \"1\")) for _, _, data in G.edges(data=True))\n",
    "\n",
    "    rng = random.Random(QM9_CONDITION_PLOT_SEED)\n",
    "    condition_graphs = rng.sample(list(test_graphs), k=min(QM9_CONDITION_DECODE_N, len(test_graphs)))\n",
    "\n",
    "    _gen = decompositional_encoder_decoder.conditioning_to_node_embeddings_generator.conditional_node_generator\n",
    "    _old_steps = getattr(_gen, \"total_steps\", None)\n",
    "    _gen.total_steps = int(QM9_CONDITION_DECODE_STEPS)\n",
    "    condition_vectors = decompositional_encoder_decoder.graph_encode(condition_graphs)\n",
    "    qm9_condition_decoded_graphs = decompositional_encoder_decoder.decode(condition_vectors)\n",
    "    if _old_steps is not None:\n",
    "        _gen.total_steps = _old_steps\n",
    "\n",
    "    rows = []\n",
    "    grid_mols = []\n",
    "    legends = []\n",
    "    qm9_condition_nx_pair_graphs = []\n",
    "    qm9_condition_nx_pair_titles = []\n",
    "    for idx, (condition_graph, decoded_graph) in enumerate(zip(condition_graphs, qm9_condition_decoded_graphs)):\n",
    "        condition_mol, condition_error = _nx_molecule_to_rdkit_safe_local(condition_graph)\n",
    "        decoded_mol, decoded_error = _nx_molecule_to_rdkit_safe_local(decoded_graph)\n",
    "\n",
    "        condition_smiles = Chem.MolToSmiles(condition_mol) if condition_error is None and condition_mol is not None else None\n",
    "        decoded_smiles = Chem.MolToSmiles(decoded_mol) if decoded_error is None and decoded_mol is not None else None\n",
    "\n",
    "        rows.append({\n",
    "            \"pair\": idx,\n",
    "            \"condition_valid\": condition_error is None,\n",
    "            \"decoded_valid\": decoded_error is None,\n",
    "            \"condition_nodes\": condition_graph.number_of_nodes(),\n",
    "            \"decoded_nodes\": decoded_graph.number_of_nodes(),\n",
    "            \"condition_edges\": condition_graph.number_of_edges(),\n",
    "            \"decoded_edges\": decoded_graph.number_of_edges(),\n",
    "            \"same_node_count\": condition_graph.number_of_nodes() == decoded_graph.number_of_nodes(),\n",
    "            \"same_edge_count\": condition_graph.number_of_edges() == decoded_graph.number_of_edges(),\n",
    "            \"same_atom_hist\": _graph_atom_hist(condition_graph) == _graph_atom_hist(decoded_graph),\n",
    "            \"same_bond_hist\": _graph_bond_hist(condition_graph) == _graph_bond_hist(decoded_graph),\n",
    "            \"condition_smiles\": condition_smiles,\n",
    "            \"decoded_smiles\": decoded_smiles,\n",
    "            \"decoded_error\": decoded_error,\n",
    "        })\n",
    "\n",
    "        # Pair only the display subset; metrics/table still include all decoded conditions.\n",
    "        if idx < QM9_CONDITION_DISPLAY_N:\n",
    "            condition_graph_plot = condition_graph.copy()\n",
    "            decoded_graph_plot = decoded_graph.copy()\n",
    "            condition_graph_plot.graph[\"plot_title\"] = f\"{idx} condition\"\n",
    "            decoded_graph_plot.graph[\"plot_title\"] = f\"{idx} decoded\"\n",
    "            qm9_condition_nx_pair_graphs.extend([condition_graph_plot, decoded_graph_plot])\n",
    "            if condition_mol is not None:\n",
    "                AllChem.Compute2DCoords(condition_mol)\n",
    "                grid_mols.append(condition_mol)\n",
    "                legends.append(f\"{idx} condition\")\n",
    "            else:\n",
    "                grid_mols.append(Chem.MolFromSmiles(\"\"))\n",
    "                legends.append(f\"{idx} condition invalid\")\n",
    "\n",
    "            if decoded_mol is not None and decoded_error is None:\n",
    "                AllChem.Compute2DCoords(decoded_mol)\n",
    "                grid_mols.append(decoded_mol)\n",
    "                legends.append(f\"{idx} decoded\")\n",
    "            else:\n",
    "                grid_mols.append(Chem.MolFromSmiles(\"\"))\n",
    "                legends.append(f\"{idx} decoded invalid\")\n",
    "\n",
    "    qm9_condition_decode_pairs = pd.DataFrame(rows)\n",
    "    print(f\"Decoded {len(qm9_condition_decoded_graphs)} molecules from {len(condition_graphs)} real test conditions.\")\n",
    "    print(\"Each pair is: real test molecule used as graph-level condition -> decoded molecule from that condition.\")\n",
    "    display(qm9_condition_decode_pairs)\n",
    "\n",
    "    summary = pd.DataFrame([{\n",
    "        \"n_pairs\": len(qm9_condition_decode_pairs),\n",
    "        \"decoded_valid\": int(qm9_condition_decode_pairs[\"decoded_valid\"].sum()),\n",
    "        \"decoded_valid_rate\": float(qm9_condition_decode_pairs[\"decoded_valid\"].mean()) if len(qm9_condition_decode_pairs) else 0.0,\n",
    "        \"same_node_count\": int(qm9_condition_decode_pairs[\"same_node_count\"].sum()),\n",
    "        \"same_edge_count\": int(qm9_condition_decode_pairs[\"same_edge_count\"].sum()),\n",
    "        \"same_atom_hist\": int(qm9_condition_decode_pairs[\"same_atom_hist\"].sum()),\n",
    "        \"same_bond_hist\": int(qm9_condition_decode_pairs[\"same_bond_hist\"].sum()),\n",
    "    }])\n",
    "    print(\"Condition-vs-decoded summary\")\n",
    "    display(summary)\n",
    "\n",
    "    if grid_mols:\n",
    "        print(f\"Showing first {min(QM9_CONDITION_DISPLAY_N, len(condition_graphs))} condition/decode pairs.\")\n",
    "        display(Draw.MolsToGridImage(\n",
    "            grid_mols,\n",
    "            molsPerRow=2,\n",
    "            subImgSize=(260, 220),\n",
    "            legends=legends,\n",
    "        ))\n",
    "\n",
    "    if qm9_condition_nx_pair_graphs:\n",
    "        print(\"NetworkX view of the same condition/decode pairs\")\n",
    "        plot_networkx_graphs(\n",
    "            qm9_condition_nx_pair_graphs,\n",
    "            n_cols=2,\n",
    "            graph_title_attr=\"plot_title\",\n",
    "            figsize_per_graph=(3.0, 2.6),\n",
    "            node_label_attr=\"label\",\n",
    "            edge_label_attr=\"label\",\n",
    "            node_size=170,\n",
    "            edge_width=1.8,\n",
    "            font_size=7,\n",
    "            layout=\"kamada_kawai\",\n",
    "        )\n",
    "else:\n",
    "    print(\"Skipping QM9 condition-vs-decoded plot because DATASET_MODE != 'qm9'.\")\n"
   ]
