   "source": [
    "# ===== QM9 molecular validity summary =====\n",
    "if globals().get(\"DATASET_MODE\") == \"qm9\":\n",
    "    from collections import Counter\n",
    "    import pandas as pd\n",
    "    import networkx as nx\n",
    "    from IPython.display import display\n",
    "    from rdkit import Chem\n",
    "\n",
    "    def _nx_molecule_to_rdkit_safe(G):\n",
    "        mol = Chem.RWMol()\n",
    "        node_to_atom = {}\n",
    "        for node, data in G.nodes(data=True):\n",
    "            symbol = str(data.get(\"label\", \"C\"))\n",
    "            try:\n",
    "                node_to_atom[node] = mol.AddAtom(Chem.Atom(symbol))\n",
    "            except Exception:\n",
    "                return None, f\"bad atom label {symbol!r}\"\n",
    "\n",
    "        for u, v, data in G.edges(data=True):\n",
    "            raw = str(data.get(\"label\", \"1\"))\n",
    "            if raw in {\"1\", \"1.0\", \"SINGLE\"}:\n",
    "                bond_type = Chem.BondType.SINGLE\n",
    "            elif raw in {\"2\", \"2.0\", \"DOUBLE\"}:\n",
    "                bond_type = Chem.BondType.DOUBLE\n",
    "            elif raw in {\"3\", \"3.0\", \"TRIPLE\"}:\n",
    "                bond_type = Chem.BondType.TRIPLE\n",
    "            elif raw in {\"1.5\", \"AROMATIC\"}:\n",
    "                bond_type = Chem.BondType.AROMATIC\n",
    "            else:\n",
    "                return None, f\"bad bond label {raw!r}\"\n",
    "            try:\n",
    "                mol.AddBond(node_to_atom[u], node_to_atom[v], bond_type)\n",
    "            except Exception as exc:\n",
    "                return None, str(exc)\n",
    "\n",
    "        out = mol.GetMol()\n",
    "        try:\n",
    "            Chem.SanitizeMol(out)\n",
    "        except Exception as exc:\n",
    "            return out, str(exc)\n",
    "        return out, None\n",
    "\n",
    "    molecule_eval_graphs = globals().get(\"sampled_graphs\", [])\n",
    "    rows = []\n",
    "    smiles = []\n",
    "    for idx, G in enumerate(molecule_eval_graphs):\n",
    "        mol, error = _nx_molecule_to_rdkit_safe(G)\n",
    "        valid = error is None and mol is not None\n",
    "        smi = Chem.MolToSmiles(mol) if valid else None\n",
    "        if smi is not None:\n",
    "            smiles.append(smi)\n",
    "        rows.append({\n",
    "            \"index\": idx,\n",
    "            \"valid_rdkit\": bool(valid),\n",
    "            \"connected\": nx.is_connected(G) if G.number_of_nodes() > 0 else False,\n",
    "            \"n_nodes\": G.number_of_nodes(),\n",
    "            \"n_edges\": G.number_of_edges(),\n",
    "            \"smiles\": smi,\n",
    "            \"error\": error,\n",
    "        })\n",
    "\n",
    "    molecular_sample_evaluation = pd.DataFrame(rows)\n",
    "    molecular_sample_summary = pd.DataFrame([\n",
    "        {\n",
    "            \"n\": len(molecular_sample_evaluation),\n",
    "            \"valid_rdkit\": int(molecular_sample_evaluation[\"valid_rdkit\"].sum()) if len(molecular_sample_evaluation) else 0,\n",
    "            \"valid_rate\": float(molecular_sample_evaluation[\"valid_rdkit\"].mean()) if len(molecular_sample_evaluation) else 0.0,\n",
    "            \"unique_valid_smiles\": len(set(smiles)),\n",
    "        }\n",
    "    ])\n",
    "    print(\"Generated molecule validity summary\")\n",
    "    display(molecular_sample_summary)\n",
    "    display(molecular_sample_evaluation.head(20))\n",
    "else:\n",
    "    print(\"Skipping molecular validity summary because DATASET_MODE != 'qm9'.\")\n"
   ]
  },
