    "    size_max = 1450\n",
    "\n",
    "    def _bubble_size(values):\n",
    "        values = np.asarray(values, dtype=float)\n",
    "        return size_min + (values / max(max_count, 1)) * (size_max - size_min)\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(15.5, 5.8), sharex=True, sharey=True)\n",
    "    plot_specs = [\n",
