    "                \"sum\",\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "    all_experiment_summary[\"cycle_rate\"] = (\n",
    "        all_experiment_summary[\"exactly_one_requested_cycle\"]\n",
    "        / all_experiment_summary[\"n\"]\n",
    "    )\n",
    "    all_experiment_summary[\"cycle_with_valid_labels_rate\"] = (\n",
    "        all_experiment_summary[\n",
