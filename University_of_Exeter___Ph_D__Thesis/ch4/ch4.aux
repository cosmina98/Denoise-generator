\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.1}Joint Edge State}{86}{subsection.4.4.1}\protected@file@percent }
\newlabel{sec:generator:joint-edge-state}{{4.4.1}{86}{Joint Edge State}{subsection.4.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces  Joint edge-state mechanism. During training, the clean adjacency \(A_0\) is corrupted into a noisy edge state \(A_t^{\mathrm  {state}}\). During sampling, the current edge state is fed into the denoiser, updated using the predicted edge-probability matrix, and reused at the next reverse step. The final graph is still obtained by constrained decoding rather than by directly sampling all edges from this state. }}{88}{figure.caption.94}\protected@file@percent }
\newlabel{fig:generator:joint-edge-state}{{4.2}{88}{Joint edge-state mechanism. During training, the clean adjacency \(A_0\) is corrupted into a noisy edge state \(A_t^{\mathrm {state}}\). During sampling, the current edge state is fed into the denoiser, updated using the predicted edge-probability matrix, and reused at the next reverse step. The final graph is still obtained by constrained decoding rather than by directly sampling all edges from this state}{figure.caption.94}{}}
