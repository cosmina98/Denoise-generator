\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Example NSPPK structural features. Top: two radius-1 neighbourhoods centred at an anchor pair whose vertices are at shortest-path distance 4, together with their union-of-shortest-paths connector for $r'=0$, corresponding to a single shortest path. Bottom: an analogous anchor-pair configuration in which the two anchors are again at distance 4, but the connector contains two distinct shortest paths of length 4.}}{54}{figure.caption.64}\protected@file@percent }
\newlabel{fig:example}{{3.1}{54}{Example NSPPK structural features. Top: two radius-1 neighbourhoods centred at an anchor pair whose vertices are at shortest-path distance 4, together with their union-of-shortest-paths connector for $r'=0$, corresponding to a single shortest path. Bottom: an analogous anchor-pair configuration in which the two anchors are again at distance 4, but the connector contains two distinct shortest paths of length 4}{figure.caption.64}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.3}From subgraphs to explicit features}{54}{subsection.3.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.4}Feature hashing pipeline}{55}{subsection.3.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces \textbf  {NSPDK vs.\ NSPPK on anchors $u,v$ with $r=1$ and $d=5$.} \emph  {Left:} NSPDK features for the case with a single shortest path (top) and two equal-length shortest paths (bottom). Because NSPDK uses only $(N_r(u),d(u,v),N_r(v))$, both cases produce the same feature. \emph  {Right:} NSPPK includes the connector $C_{r'}(u,v)=N_{r'}(U(u,v))$ (shown in green). The connector is a simple path in the top graph but a two-path union in the bottom graph, so NSPPK induces different features.}}{57}{figure.caption.65}\protected@file@percent }
\newlabel{fig:nspdk-vs-nsppk-example}{{3.2}{57}{\textbf {NSPDK vs.\ NSPPK on anchors $u,v$ with $r=1$ and $d=5$.} \emph {Left:} NSPDK features for the case with a single shortest path (top) and two equal-length shortest paths (bottom). Because NSPDK uses only $(N_r(u),d(u,v),N_r(v))$, both cases produce the same feature. \emph {Right:} NSPPK includes the connector $C_{r'}(u,v)=N_{r'}(U(u,v))$ (shown in green). The connector is a simple path in the top graph but a two-path union in the bottom graph, so NSPPK induces different features}{figure.caption.65}{}}
