\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces RankGen ranks on \textbf  {CIFAR--10}, \textbf  {MNIST}, and \textbf  {Fashion--MNIST}. Lower is better. StyleGAN2-lite exhibits high Quality but low Utility and Similarity, echoing our synthetic mode-collapse setting. This suggests strong precision but poor coverage—models of this type risk overfitting narrow regions of the data. VAEs remain competitive on digits.}}{128}{figure.caption.137}\protected@file@percent }
\newlabel{fig:cifar10-ranks}{{5.6}{128}{RankGen ranks on \textbf {CIFAR--10}, \textbf {MNIST}, and \textbf {Fashion--MNIST}. Lower is better. StyleGAN2-lite exhibits high Quality but low Utility and Similarity, echoing our synthetic mode-collapse setting. This suggests strong precision but poor coverage—models of this type risk overfitting narrow regions of the data. VAEs remain competitive on digits}{figure.caption.137}{}}
