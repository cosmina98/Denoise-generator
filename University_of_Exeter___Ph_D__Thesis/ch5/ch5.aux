\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces \textbf  {RankGen vs.\ conventional metrics (by dataset).} Cells show Spearman correlations between RankGen metrics ($Q,U,S,I,\mathcal  {E}_{\min }$) and conventional metrics (FID, KID, P, R, $F_{1,\mathrm  {pr}}$, IS) on \textbf  {CIFAR--10}, \textbf  {Fashion--MNIST}, and \textbf  {MNIST}. RankGen $Q$ and $S$ track precision and recall, while exchangeability aligns most closely with $F_1$. IS shows the weakest alignment.}}{135}{figure.caption.138}\protected@file@percent }
\newlabel{fig:mnist-ranks}{{5.7}{135}{\textbf {RankGen vs.\ conventional metrics (by dataset).} Cells show Spearman correlations between RankGen metrics ($Q,U,S,I,\mathcal {E}_{\min }$) and conventional metrics (FID, KID, P, R, $F_{1,\mathrm {pr}}$, IS) on \textbf {CIFAR--10}, \textbf {Fashion--MNIST}, and \textbf {MNIST}. RankGen $Q$ and $S$ track precision and recall, while exchangeability aligns most closely with $F_1$. IS shows the weakest alignment}{figure.caption.138}{}}
